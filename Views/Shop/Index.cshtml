@model IEnumerable<E_Commerce.Models.Product>

@{
    ViewData["Title"] = "Shop";
}

@if (TempData["success"] != null)
{
    <div class="alert alert-success">
        @TempData["success"]
    </div>
}

<!-- Hero Section -->

<div class="container-fluid bg-dark text-white p-4 mb-4 rounded-4 shadow">

    <div class="text-center">

        <h1 class="display-5 fw-bold">
            Welcome To My Shop
        </h1>

        <p class="text-light mb-0">
            Best Products At Best Prices
        </p>

    </div>

</div>

<!-- Search -->

<form method="get" class="mb-4">

    <div class="row g-2">

        <div class="col-md-10">

            <input id="searchInput"
                   type="text"
                   name="search"
                   class="form-control form-control-lg rounded-pill"
                   placeholder="Search products..." />

        </div>

        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-primary btn-lg w-100 rounded-pill">

                Search

            </button>

        </div>

    </div>

</form>

<!-- Products -->

<div class="container">

    <div class="row g-4" id="products">

        @foreach (var item in Model)
        {
            <div class="col-6 col-md-4 col-lg-3 product-item">

                <!-- Clickable Card -->

                <a asp-controller="Shop"
                       asp-action="Details"
                       asp-route-id="@item.ProductId"
                       class="text-decoration-none text-dark">

                    <div class="card border-0 shadow-sm rounded-4 h-100 product-card">

                        <!-- Image -->

                        <div class="text-center p-3">

                            <img src="@item.ImagePath"
                                 class="img-fluid"
                                 style="height:180px; object-fit:contain;" />

                        </div>

                        <!-- Body -->

                        <div class="card-body pt-0">

                            <!-- Product Name -->

                            <h6 class="fw-bold mb-2 product-title">

                                @item.ProductName

                            </h6>

                            <!-- Rating -->

                            <div class="mb-2">

                                <span class="text-warning">
                                    ★★★★☆
                                </span>

                                <small class="text-muted">
                                    2,540
                                </small>

                            </div>

                            <!-- Price -->

                            <h5 class="text-success fw-bold mb-2">

                                ₹ @String.Format(new System.Globalization.CultureInfo("en-IN"),"{0:N0}",item.Price)

                            </h5>

                            <!-- Description -->

                            <p class="text-muted small mb-3">

                                @(item.Description != null &&
                                    item.Description.Length > 60

                                    ? item.Description.Substring(0, 60) + "..."

                                    : item.Description)

                            </p>

                            <!-- Stock -->

                            <small class="text-success fw-bold">
                                In Stock
                            </small>

                        </div>

                        @* <!-- Button -->

                        <div class="px-3 pb-3">

                            <button class="btn btn-warning w-100 rounded-pill fw-bold add-cart-btn">

                                Add To Cart

                            </button>

                        </div> *@

                    </div>

                </a>

            </div>
        }

    </div>

</div>

<!-- CSS -->

<style>

    .product-card {
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

    .product-title {
        font-size: 16px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 45px;
    }

</style>
