@model IEnumerable<E_Commerce.Models.Cart>

<div class="container mt-3">

    <!-- Subtotal -->
    <div class="bg-white p-3 rounded shadow-sm mb-3">

        <h3 class="fw-bold text-center">
            SUBTOTAL ₹ @Model.Sum(x => x.Product!.Price * x.Quantity)
        </h3>
        <button type="submit" class="btn btn-warning w-100 mt-3 fw-bold rounded-pill py-2">
            Proceed To Buy (@Model.Count() items)
        </button>

    </div>

    <!-- Cart Items -->
    @foreach (var item in Model)
    {
        <div class="card border-0 shadow-sm mb-3 rounded-4">

            <div class="card-body">

                <div class="row">

                    <!-- Product Image -->
                    <div class="col-4">

                        <img src="@item.Product?.ImagePath"
                             class="img-fluid rounded"
                             style="height:120px; object-fit:contain;" />

                    </div>

                    <!-- Product Details -->
                    <div class="col-8">

                        <h6 class="fw-bold">
                            @item.Product?.ProductName
                        </h6>

                        <h4 class="fw-bold mt-2">
                            ₹ @item.Product?.Price
                        </h4>

                        <p class="text-success fw-bold mb-1">
                            In Stock
                        </p>

                        <p class="text-muted small">
                            FREE Delivery Tomorrow
                        </p>

                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex flex-wrap gap-2 mt-3">

                    <!-- Quantity -->
                    <div class="border border-warning rounded-pill d-flex align-items-center px-2">

                        <a asp-controller="Cart"
                               asp-action="Decrease"
                               asp-route-id="@item.CartId"
                               class="btn btn-sm">
                            -
                        </a>

                        <span class="mx-2 fw-bold">
                            @item.Quantity
                        </span>

                        <a asp-controller="Cart"
                               asp-action="Increase"
                               asp-route-id="@item.CartId"
                               class="btn btn-sm">
                            +
                        </a>

                    </div>

                    <!-- Delete -->
                    <a asp-controller="Cart"
                           asp-action="Remove"
                           asp-route-id="@item.CartId"
                           class="btn btn-outline-danger rounded-pill">
                        Delete
                    </a>

                    <!-- Buy -->
                    <a asp-controller="Order"
                           asp-action="PlaceOrder"
                           asp-route-id="@item.ProductId"
                           class="btn btn-dark rounded-pill">
                        Buy Now
                    </a>

                </div>

            </div>

        </div>
    }

</div>