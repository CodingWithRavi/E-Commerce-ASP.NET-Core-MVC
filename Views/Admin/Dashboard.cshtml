@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-5">

    <!-- Heading -->

    <div class="mb-5">

        <h1 class="fw-bold">
            Admin Dashboard
        </h1>

        <p class="text-muted">
            Manage your e-commerce store
        </p>

    </div>

    <!-- Cards -->

    <div class="row g-4">

        <!-- Products -->

        <div class="col-md-4">

            <div class="card border-0 shadow rounded-4 h-100">

                <div class="card-body text-center p-4">

                    <div class="mb-3 fs-1">
                        📦
                    </div>

                    <h5 class="fw-bold">
                        Total Products
                    </h5>

                    <h1 class="text-primary fw-bold">
                        @ViewBag.TotalProducts
                    </h1>

                    <a asp-controller="Product"
                           asp-action="Index"
                           class="btn btn-primary mt-3 px-4 rounded-pill">

                        Manage Products

                    </a>

                </div>

            </div>

        </div>

        <!-- Categories -->

        <div class="col-md-4">

            <div class="card border-0 shadow rounded-4 h-100">

                <div class="card-body text-center p-4">

                    <div class="mb-3 fs-1">
                        🗂️
                    </div>

                    <h5 class="fw-bold">
                        Total Categories
                    </h5>

                    <h1 class="text-success fw-bold">
                        @ViewBag.TotalCategories
                    </h1>

                    <a asp-controller="Categories"
                           asp-action="Create"
                           class="btn btn-success mt-3 px-4 rounded-pill">

                        Manage Categories

                    </a>

                </div>

            </div>

        </div>
        <!-- Total Order -->

        <div class="col-md-4">

            <div class="card border-0 shadow rounded-4 h-100">

                <div class="card-body text-center p-4">

                    <div class="mb-3 fs-1">
                        📦
                    </div>

                    <h5 class="fw-bold">
                        Total Order
                    </h5>

                    <h1 class="text-success fw-bold">
                        @ViewBag.TotalOrder
                    </h1>

                    <a asp-controller="Admin"
                           asp-action="TotalOrder"
                           class="btn btn-success mt-3 px-4 rounded-pill">

                        Manage Order

                    </a>

                </div>

            </div>

        </div>

        <!-- Users -->

        <div class="col-md-4">

            <div class="card border-0 shadow rounded-4 h-100">

                <div class="card-body text-center p-4">

                    <div class="mb-3 fs-1">
                        👤
                    </div>

                    <h5 class="fw-bold">
                        Total Users
                    </h5>

                    <h1 class="text-danger fw-bold">
                        @ViewBag.TotalUsers
                    </h1>

                    <button class="btn btn-danger mt-3 px-4 rounded-pill">

                        Users

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>