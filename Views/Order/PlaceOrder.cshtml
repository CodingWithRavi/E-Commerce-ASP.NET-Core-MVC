@model Product

<div class="container mt-5">

    <div class="row">

        <div class="col-md-5">

            <img src="@Model.ImagePath"
                 class="img-fluid border rounded" />

        </div>

        <div class="col-md-7">

            <h2>@Model.ProductName</h2>

            <h3 class="text-success mt-3">
                ₹ @Model.Price
            </h3>

            <p class="mt-3">
                @Model.Description
            </p>

            <form asp-action="PlaceOrder" method="post">

                <!-- Product Id -->
                <input type="hidden"
                       name="ProductId"
                       value="@Model.ProductId" />

                <div class="mb-3">

                    <label class="form-label">
                        Full Name
                    </label>

                    <input type="text"
                           name="Name"
                           class="form-control"
                           required />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Address
                    </label>

                    <textarea name="Address"
                              class="form-control"
                              rows="4"
                              required></textarea>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Phone Number
                    </label>

                    <input type="text"
                           name="PhoneNumber"
                           class="form-control"
                           required />

                </div>

                <button type="submit"
                        class="btn btn-success">
                    Place Order
                </button>

                <a asp-controller="Shop"
                       asp-action="Details"
                       asp-route-id="@Model.ProductId"
                       class="btn btn-secondary">
                    Back
                </a>

            </form>

        </div>

    </div>

</div>