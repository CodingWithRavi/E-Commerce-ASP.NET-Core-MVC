@model E_Commerce.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9 col-12">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->

                <div class="bg-dark text-white p-4">

                    <h1 class="fw-bold mb-0">
                        Edit Product
                    </h1>

                </div>

                <!-- Form -->

                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <input type="hidden"
                               asp-for="ProductId" />

                        <!-- Product Name -->

                        <div class="mb-4">

                            <label asp-for="ProductName"
                                   class="form-label fw-bold fs-5">
                            </label>

                            <input asp-for="ProductName"
                                   class="form-control form-control-lg rounded-4"
                                   placeholder="Enter product name" />

                            <span asp-validation-for="ProductName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Price -->

                        <div class="mb-4">

                            <label asp-for="Price"
                                   class="form-label fw-bold fs-5">
                            </label>

                            <input asp-for="Price"
                                   class="form-control form-control-lg rounded-4"
                                   placeholder="Enter price" />

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Description -->

                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-bold fs-5">
                            </label>

                            <textarea asp-for="Description"
                                      rows="5"
                                      class="form-control form-control-lg rounded-4"
                                      placeholder="Enter product description"></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Image -->

                        <div class="mb-4">

                            <label asp-for="ImagePath"
                                   class="form-label fw-bold fs-5">
                            </label>

                            <select asp-for="ImagePath"
                                    class="form-select form-select-lg rounded-4"
                                    asp-items="ViewBag.Images">

                                <option value="">
                                    Select Product Image
                                </option>

                            </select>

                            <span asp-validation-for="ImagePath"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Category -->

                        <div class="mb-4">

                            <label asp-for="CategoryId"
                                   class="form-label fw-bold fs-5">
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select form-select-lg rounded-4"
                                    asp-items="ViewBag.CategoryId">

                                <option value="">
                                    Select Category
                                </option>

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Buttons -->

                        <div class="d-flex gap-3 mt-4">

                            <button type="submit"
                                    class="btn btn-dark btn-lg px-4 rounded-4">

                                Save Changes

                            </button>

                            <a asp-action="Index"
                                   class="btn btn-outline-secondary btn-lg px-4 rounded-4">

                                Back

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}